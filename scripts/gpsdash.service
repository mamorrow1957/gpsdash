[Unit]
Description=gpsdash — ntp.local status dashboard
After=network.target

[Service]
Type=simple
User=michael
WorkingDirectory=/home/michael/gpsdash
ExecStart=/usr/bin/node server.js
Environment=PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure

[Install]
WantedBy=multi-user.target
